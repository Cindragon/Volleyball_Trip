DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string_at_least_16_chars
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
FRONTEND_URL=https://your-app.vercel.app
ADMIN_EMAILS=your@email.com
TRUST_PROXY=0
# Optional: initial admin created by `npm run seed`. If SEED_ADMIN_PASSWORD is
# empty a random password is generated and printed once. Setting it and
# re-running seed also rotates the existing admin's password.
SEED_ADMIN_EMAIL=admin@volleytrip.local
SEED_ADMIN_PASSWORD=
