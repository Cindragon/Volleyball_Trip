# Google Maps browser key (restrict to HTTP referrers, e.g. http://localhost:5173/*)
VITE_GOOGLE_MAPS_KEY=your_google_maps_browser_key_here
# Map ID from Google Cloud Console -> Map Management (JavaScript, Vector).
# Optional: falls back to DEMO_MAP_ID for local development.
VITE_GOOGLE_MAP_ID=
# Optional: backend origin (default http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001
